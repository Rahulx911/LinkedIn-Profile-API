# Copy this file to .env and fill in real values. Never commit .env.
#
# How to get LI_AT_COOKIE:
#   1. Log into LinkedIn in your browser with the account you're using for this project
#      (ideally not your primary/personal account — LinkedIn can restrict accounts used
#      for automated access, see README "Known limitations").
#   2. Open DevTools -> Application tab -> Cookies -> https://www.linkedin.com
#   3. Copy the value of the cookie named "li_at"
LI_AT_COOKIE=

# Optional: LinkedIn also issues a JSESSIONID cookie used as the CSRF token for
# some endpoints. Copy it the same way (Application -> Cookies -> JSESSIONID).
# Include the surrounding double quotes exactly as LinkedIn sends them, e.g. "ajax:1234567890123456789"
JSESSIONID=

# In-memory cache TTL for profile lookups, in seconds. Keeps repeat lookups of the
# same profile from re-hitting LinkedIn (rate-limit / ban risk mitigation).
PROFILE_CACHE_TTL_SECONDS=3600

# Request timeout to LinkedIn, in seconds.
LINKEDIN_REQUEST_TIMEOUT_SECONDS=15
